generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id               Int      @id @default(autoincrement())
  orderNumber      String   @unique
  total            Float
  status           String   @default("Нове")
  paymentType      String   @default("card")
  paymentStatus    String   @default("pending")
  items            String   @db.Text
  orderItems       Json     @default("[]")
  delivery         String   @default("")
  deliveryType     String   @default("")
  cityName         String   @default("")
  cityRef          String   @default("")
  deliveryPoint    String   @default("")
  courierHouse     String   @default("")
  courierApartment String   @default("")
  courierEntrance  String   @default("")
  courierFloor     String   @default("")
  noCall           Boolean  @default(false)
  comment          String?
  ttn              String?
  paymentUrl       String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  tags             OrderTag[]
}

model Category {
  id              Int               @id @default(autoincrement())
  name            String
  slug            String            @unique
  description     String?
  imageUrl        String?
  metaTitle       String?
  metaDescription String?
  seoAlt          String?
  isPublished     Boolean           @default(true)
  parentId        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              Int               @id @default(autoincrement())
  name            String
  sku             String            @unique
  slug            String            @unique
  description     String?           @db.Text
  fullDescription String?           @db.Text
  metaTitle       String?
  metaDescription String?
  seoAlt          String?
  badge           String?
  isPublished     Boolean           @default(false)
  isPopular       Boolean           @default(false)
  isNew           Boolean           @default(false)
  relatedIds      Json              @default("[]")
  relatedLabels   Json              @default("{}")
  bundleProductId Int?
  status          String            @default("DRAFT")
  price           Float             @default(0)
  oldPrice        Float?
  wholesalePrice  Float?
  hasWholesale    Boolean           @default(false)
  stock           Int               @default(0)
  volume          String?
  containerType   String?
  dimensions      String?
  productType     String            @default("SINGLE")
  brandId         Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  brand           Brand?            @relation(fields: [brandId], references: [id])
  bundleProduct   Product?          @relation("BundleProduct", fields: [bundleProductId], references: [id])
  bundledIn       Product[]         @relation("BundleProduct")
  relatedProducts Product[]         @relation("ProductVersions")
  relatedTo       Product[]         @relation("ProductVersions")
  categories      ProductCategory[]
  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
}

model ProductCategory {
  productId   Int
  categoryId  Int
  isMain      Boolean  @default(false)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  sort      Int     @default(0)
  isMain    Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id             Int     @id @default(autoincrement())
  productId      Int
  sku            String
  size           String?
  volume         String
  packageType    String
  priceRetail    Float   @default(0)
  priceWholesale Float?
  stock          Int     @default(0)
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  comment      String?  @db.Text
  userName     String
  productId    Int?
  isStoreReview Boolean  @default(false)
  isPublished  Boolean  @default(false)
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model OrderTag {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CalculatorAddon {
  id   String @id
  name String
  val  Float
}

model CalculatorProduct {
  id   Int    @id @default(autoincrement())
  name String
  buy  Float
  vol  Float
  dose Float
  sale Float
  adds Json
}

model CalculatorBundle {
  id    Int    @id @default(autoincrement())
  name  String
  sale  Float
  items Json
  adds  Json
}

model FinanceSale {
  id        Int      @id @default(autoincrement())
  timestamp BigInt
  date      String
  type      String   @default("sale")
  status    String   @default("transit")
  comment   String   @default("")
  items     Json
}

model FinanceSettings {
  id            Int   @id @default(autoincrement())
  usdRate       Float @default(41.5)
  targetProfit  Int   @default(30000)
  targetRevenue Int   @default(80000)
}

model CallbackRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  comment   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Post {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  content       String   @db.Text
  excerpt       String?
  image         String?
  status        String   @default("DRAFT")
  metaTitle     String?
  metaDescription String?
  productIds    Json     @default("[]")
  ctaText       String?
  ctaUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LandingPage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  subtitle        String?
  productName     String   @default("")
  productDesc     String?  @db.Text
  productPrice    Float    @default(0)
  productOldPrice Float?
  productImage    String?
  productImages   Json     @default("[]")
  ctaText         String   @default("Купити")
  bgColor         String   @default("#F9F9F7")
  btnColor        String   @default("#0B53A4")
  textColor       String   @default("#111111")
  metaTitle       String?
  metaDescription String?
  reviews         Json     @default("[]")
  advantages      Json     @default("[]")
  useCases        Json     @default("[]")
  stockCount      Int      @default(50)
  discountPercent Int      @default(47)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradingPair {
  id          Int      @id @default(autoincrement())
  symbol      String   @unique
  name        String?
  groupName   String   @default("")
  chartStatus String   @default("UNCLEAR")
  priority    Int      @default(0)
  notes       String?  @db.Text
  tags        Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
