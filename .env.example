# Database
DATABASE_URL=

# Site
NEXT_PUBLIC_SITE_URL=https://brosco.com.ua

# Admin gate (set ADMIN_PASSWORD to enable cookie-protected /admin/*)
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Optional: public entry URL segment (must start with /, no query). When set with ADMIN_PASSWORD,
# only this path (rewritten to the gate UI) works; /admin/gate returns 404 for direct requests.
ADMIN_GATE_PATH=
